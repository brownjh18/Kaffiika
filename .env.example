# Backend
PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_EMAIL=admin@kaffiikafeeds.com
ADMIN_DEFAULT_PASSWORD=admin123
DB_PATH=./server/data/app.sqlite
# Optional: CORS_ORIGIN=http://127.0.0.1:5173,https://your-domain.vercel.app

# Frontend -> Backend API base URL (leave empty for same-origin / Vite proxy)
# Example for separate backend deployment: VITE_API_URL=https://your-backend.example.com
VITE_API_URL=

# Google sign-in (Google Identity Services)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Add authorized JavaScript origins for local dev and production.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

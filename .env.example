# Optional admin portal defaults (client-side only; do not use for real security)
VITE_ADMIN_EMAIL=kaffiikanimalfeeds@gmail.com
VITE_ADMIN_PASSWORD=

# Google sign-in (Google Identity Services)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Add authorized JavaScript origins for local dev and production, e.g.:
#   http://127.0.0.1:5173
#   http://localhost:5173
#   https://your-vercel-domain.vercel.app
# Then set this value locally in .env and in Vercel Project Settings > Environment Variables.
VITE_GOOGLE_CLIENT_ID=
